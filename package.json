{
  "name": "starloghq",
  "version": "0.8.0",
  "mcpName": "io.github.starloghq/starlog",
  "description": "Better library decisions for your AI coding agent — a local MCP tool and package-install hook that indexes library capabilities. Free, no account.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai",
    "coding-agent",
    "claude",
    "claude-code",
    "library-recommendations",
    "capability-manifest"
  ],
  "homepage": "https://starlog.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/starloghq/index.git"
  },
  "bugs": {
    "url": "https://github.com/starloghq/index/issues"
  },
  "author": "Starlog",
  "type": "module",
  "bin": {
    "starlog": "dist/cli.js",
    "starloghq": "dist/cli.js"
  },
  "files": [
    "dist/",
    "corpus-free/",
    "postinstall.mjs",
    "CHANGELOG.md",
    "docs/FACTS-CONTRACT.md"
  ],
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "gen:facts": "tsx scripts/gen-l2-facts.ts",
    "build": "npm run gen:facts && node build.mjs",
    "postinstall": "node postinstall.mjs",
    "prepublishOnly": "npm run build",
    "search": "tsx src/cli.ts search",
    "bench:facts": "tsx scripts/bench-facts.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:versions": "node scripts/check-versions.mjs",
    "smoke": "bash scripts/smoke-test.sh",
    "verify:release": "bash scripts/verify-release.sh",
    "version": "node scripts/sync-server-version.mjs && git add server.json"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "BUSL-1.1",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^14.0.3",
    "dotenv": "^17.4.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "esbuild": "^0.28.0",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.7"
  }
}
